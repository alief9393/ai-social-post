# Which LLM writes the narrative: "gemini" (free tier) or "claude"
LLM_PROVIDER=gemini

# Gemini (free): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Tried in order when the main model is overloaded or out of quota (comma-separated)
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest

# Claude (paid, optional): https://console.anthropic.com
ANTHROPIC_API_KEY=
# Cheaper options: claude-sonnet-5-5, claude-haiku-4-5
CLAUDE_MODEL=claude-opus-5-5

# Optional: YouTube comments as a community source (free quota)
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# Passcode required to use the app (keeps strangers from spending your quota)
APP_PASSCODE=
